  return FVec/Cons { head: -1.095910, tail: FVec/Cons { head: -0.580396, tail: FVec/Cons { head: -0.150050, tail: FVec/Cons { head: 2.603723, tail: FVec/Cons { head: -0.663354, tail: FVec/Cons { head: 1.022813, tail: FVec/Cons { head: -0.781510, tail: FVec/Cons { head: -1.720901, tail: FVec/Cons { head: -0.076256, tail: FVec/Cons { head: 2.410372, tail: FVec/Cons { head: 0.586105, tail: FVec/Cons { head: 0.189407, tail: FVec/Cons { head: 0.664163, tail: FVec/Cons { head: -1.167178, tail: FVec/Cons { head: -0.239867, tail: FVec/Cons { head: -0.736729, tail: FVec/Cons { head: -0.499129, tail: FVec/Cons { head: 0.424046, tail: FVec/Cons { head: -1.587441, tail: FVec/Cons { head: -0.035971, tail: FVec/Cons { head: -0.165903, tail: FVec/Cons { head: -1.179701, tail: FVec/Cons { head: 0.366396, tail: FVec/Cons { head: -0.528875, tail: FVec/Cons { head: 0.782373, tail: FVec/Cons { head: -0.941849, tail: FVec/Cons { head: -1.219129, tail: FVec/Cons { head: -0.851450, tail: FVec/Cons { head: -1.419529, tail: FVec/Cons { head: 1.392901, tail: FVec/Cons { head: 0.422233, tail: FVec/Cons { head: -1.125347, tail: FVec/Cons { head: 0.472478, tail: FVec/Cons { head: 1.162100, tail: FVec/Cons { head: 0.446120, tail: FVec/Cons { head: -1.226959, tail: FVec/Cons { head: -1.149419, tail: FVec/Cons { head: -0.250848, tail: FVec/Cons { head: -1.869240, tail: FVec/Cons { head: -1.287393, tail: FVec/Cons { head: -0.016208, tail: FVec/Cons { head: 0.853258, tail: FVec/Cons { head: 0.852140, tail: FVec/Cons { head: 1.777149, tail: FVec/Cons { head: 1.766959, tail: FVec/Cons { head: -0.822180, tail: FVec/Cons { head: 1.200343, tail: FVec/Cons { head: -0.223788, tail: FVec/Nil } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }

