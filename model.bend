  return FVec/Cons { head: 0.004303, tail: FVec/Cons { head: -0.504276, tail: FVec/Cons { head: 2.349058, tail: FVec/Cons { head: 0.403536, tail: FVec/Cons { head: -0.190576, tail: FVec/Cons { head: -0.058716, tail: FVec/Cons { head: -0.666453, tail: FVec/Cons { head: -0.094257, tail: FVec/Cons { head: 1.793300, tail: FVec/Cons { head: -0.005731, tail: FVec/Cons { head: -1.557021, tail: FVec/Cons { head: 0.138618, tail: FVec/Cons { head: -1.719551, tail: FVec/Cons { head: 1.445441, tail: FVec/Cons { head: 1.263834, tail: FVec/Cons { head: -1.339140, tail: FVec/Cons { head: -1.525927, tail: FVec/Cons { head: 0.251700, tail: FVec/Cons { head: -0.754539, tail: FVec/Cons { head: 1.424492, tail: FVec/Cons { head: 0.526082, tail: FVec/Cons { head: -0.439153, tail: FVec/Cons { head: 1.270181, tail: FVec/Cons { head: -1.172687, tail: FVec/Cons { head: -1.295634, tail: FVec/Cons { head: 0.939246, tail: FVec/Cons { head: -0.556190, tail: FVec/Cons { head: -0.329390, tail: FVec/Cons { head: 0.470515, tail: FVec/Cons { head: 0.086457, tail: FVec/Cons { head: -0.307647, tail: FVec/Cons { head: -1.425395, tail: FVec/Cons { head: 1.785702, tail: FVec/Cons { head: 0.015874, tail: FVec/Cons { head: -0.439875, tail: FVec/Cons { head: 0.646603, tail: FVec/Cons { head: -1.366851, tail: FVec/Cons { head: 0.687189, tail: FVec/Cons { head: 0.442640, tail: FVec/Cons { head: -2.188128, tail: FVec/Cons { head: -2.373538, tail: FVec/Cons { head: -0.500229, tail: FVec/Cons { head: 1.654365, tail: FVec/Cons { head: 0.016010, tail: FVec/Cons { head: 1.300086, tail: FVec/Cons { head: -0.829395, tail: FVec/Cons { head: 0.879818, tail: FVec/Cons { head: 1.099162, tail: FVec/Nil } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }

def get_token_emb_row_2() -> FVec:
