def get_token(idx: u24) -> FVec:
  if idx <= 32:
    if idx <= 16:
      if idx <= 8:
        if idx <= 4:
          if idx <= 2:
            if idx <= 1:
              if idx <= 0:
                return get_token_emb_row_0()
              else:
                return get_token_emb_row_1()
            else:
              return get_token_emb_row_2()
          else:
            if idx <= 3:
              return get_token_emb_row_3()
            else:
              return get_token_emb_row_4()
        else:
          if idx <= 6:
            if idx <= 5:
